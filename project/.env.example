# API
BACKEND__HOST=0.0.0.0
BACKEND__PORT=8000

# Database
# values for running the API dev server and the db scripts locally
DB__HOST=localhost
DB__PORT=5433

# credentials the bootstrap script connects with to create the app role and
# database; see src/db/scripts/app_db.py
DB__DEFAULT_DATABASE=postgres
DB__DEFAULT_USERNAME=postgres
DB__DEFAULT_PASSWORD=postgres

# application role and database the API itself uses
DB__APP_DATABASE=tutorial
DB__APP_USERNAME=app_user
DB__APP_PASSWORD=password

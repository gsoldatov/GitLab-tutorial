# Rendered from gitlab/templates/runner-config.toml.tmpl by gitlab/setup.sh.
# Do not edit this file: change gitlab/.env and re-run setup.
#
# The authentication token is deliberately absent. It is expanded from the
# environment - see the env_file on the gitlab-runner service in
# gitlab/docker-compose.yml - so this file can be read, copied and diffed
# without carrying a secret.

concurrent = __RUNNER_CONCURRENT__
check_interval = 3

[[runners]]
  name = "__RUNNER_DESCRIPTION__"
  url = "http://__EXTERNAL_HOST__:__HTTP_PORT__"
  token = "${RUNNER_TOKEN}"
  executor = "docker"

  [runners.docker]
    image = "__RUNNER_EXECUTOR_IMAGE__"

    # The whole design rests on this socket: every job builds images and runs the
    # production stack through the host's daemon. Nothing below is privileged,
    # but the socket alone is enough to do anything on the host, which is also
    # why every job is host-root-equivalent.
    #
    # These mounts are per runner configuration (per `[[runners]]` block), not per
    # job, so the lint and test jobs inherit the socket as well. deploy lands at
    # the same absolute path here and on the host, which is what makes its bind
    # mount resolve on both sides of the daemon boundary.
    volumes = [
      "/var/run/docker.sock:/var/run/docker.sock",
      "__REPO_ROOT__/temp/deploy:__REPO_ROOT__/temp/deploy",
    ]
    privileged = false

    # No network_mode is set, which leaves every job on the default Docker
    # bridge. That is what makes `services:` safe under concurrency: since 18.7
    # the runner emulates Docker's deprecated container links with `extra_hosts`,
    # so every job container's /etc/hosts maps its services' aliases to its own
    # service containers. Two concurrent test jobs can both address Postgres as
    # `postgres` and still reach different servers, and no host port is published
    # for them to collide over. The alias is the image name with its tag
    # stripped, so `services: postgres:16-alpine` answers to `postgres` - and
    # never to `localhost`.
    #
    # Joining the GitLab compose network is the one wrong choice: a user-defined
    # network has embedded DNS, so each concurrent job's `postgres` would
    # register the same name and resolution would return one of them at random.
    # Reaching GitLab at its published address needs no extra_hosts and no
    # second name to keep in sync.
    #
    # The alternative, FF_NETWORK_PER_BUILD, gives each job a private network.
    # It is needed only if a *service* has to resolve the job container (alias
    # `build`) or another service, which nothing here does; it costs a daemon
    # reconfigured with IPv6 enabled and a network created and removed per job.

    # Governs the images the runner starts for a job - the job's `image:`, the
    # `image` above when the job declares none, and its `services:` images - and
    # pulls only those that are not already present locally.
    pull_policy = ["if-not-present"]

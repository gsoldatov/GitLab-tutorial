# Rendered from gitlab/templates/gitlab.rb.tmpl by gitlab/setup.sh.
# Do not edit this file: change gitlab/.env and re-run setup.
#
# Deliberately tuned for a single-host tutorial instance that shares this
# machine with the production stack, not for real traffic.

external_url 'http://__EXTERNAL_HOST__:__HTTP_PORT__'

# Omnibus derives nginx's listen port from external_url's port, but state it
# anyway so a careless edit of the line above fails visibly instead of silently
# moving the port out from under the published mapping in docker-compose.yml.
nginx['listen_port'] = __HTTP_PORT__

# Appears in the clone URLs. The container publishes __SSH_PORT__ on the host, so
# that is the port a developer's `git clone` has to be told about.
gitlab_rails['gitlab_shell_ssh_port'] = __SSH_PORT__

# Applied on the first configuration only, and only while root has never been
# configured. It is what lets setup log in before any other account exists.
# Must not contain a single quote: it is embedded in a Ruby string literal.
gitlab_rails['initial_root_password'] = '__ADMIN_PASSWORD__'

# /-/readiness is unauthenticated but gated by this allowlist, and traffic
# arriving through a published port is SNAT'd to the bridge gateway rather than
# appearing to come from 127.0.0.1. Without the private range, setup's readiness
# wait is refused and every run looks like a failure.
gitlab_rails['monitoring_whitelist'] = ['127.0.0.0/8', '::1', '172.16.0.0/12']

# --- memory-constrained instance --------------------------------------------
# From GitLab's guidance for memory-constrained environments. A single puma
# process and a smaller sidekiq pool are the two changes that matter; the rest
# switches off monitoring that nothing here will ever scrape.
#
# That guide has further knobs (GITALY_COMMAND_SPAWN_MAX_PARALLEL, MALLOC_CONF)
# aimed at 2-4 GB hosts. They are left out on purpose: tuning that cannot be
# explained in a line is worse than the memory it saves.
puma['worker_processes'] = 0
sidekiq['concurrency'] = 10
sidekiq['metrics_enabled'] = false
puma['exporter_enabled'] = false
prometheus_monitoring['enable'] = false
gitlab_kas['enable'] = false

# Images are built on the host and never pushed anywhere, so the bundled
# container registry would be dead weight.
registry['enable'] = false

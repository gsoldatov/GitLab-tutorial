# Configuration for the local GitLab instance and its runner.
#
# Copy to gitlab/.env and adjust. That file is gitignored; this one is not.
#
# It is read twice, so keep it to plain KEY=value lines:
#   * by docker compose (gitlab/docker-compose.yml), which interpolates ${...}
#   * by the scripts in gitlab/, which `source` it
# Quote any value containing spaces, $, backticks or other shell metacharacters.


# ---------------------------------------------------------------- images
# Pinned deliberately: a floating tag would silently change the tutorial under
# the reader. Both tags verified with `docker manifest inspect` on 2026-09-23.
# GitLab and the runner do not share patch numbers - there is no runner 19.4.1.
GITLAB_IMAGE_TAG=19.4.1-ce.0
GITLAB_RUNNER_IMAGE_TAG=alpine-v19.4.0


# ---------------------------------------------------------------- ports
# Published on the host. 8929/2222 keep clear of the host's own SSH on 22.
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2222


# ---------------------------------------------------------------- networking
# Leave empty to auto-detect the host's docker0 bridge gateway (172.17.0.1).
# That address is reachable both from this machine and from every container, so
# it works for your browser, the runner and the job containers alike.
# Set it explicitly only to browse GitLab from another machine - on a NAT'd VM
# that also needs a port forward, or the address will not be reachable.
GITLAB_EXTERNAL_HOST=


# ---------------------------------------------------------------- compose
# Names the compose project. The default network becomes gitlab-tutorial_default
# and the containers gitlab-tutorial-gitlab-1 / gitlab-tutorial-gitlab-runner-1.
COMPOSE_PROJECT_NAME=gitlab-tutorial


# ---------------------------------------------------------------- accounts
# GitLab enforces its own password rules: 8-128 characters, not a known-breached
# password, and containing no part of the user's name, username or email. The
# check is not case-sensitive, so a password containing the username is rejected.
#
# Usernames have to avoid the paths GitLab keeps for itself; setup refuses those
# before it does anything expensive. "admin" is one of them, hence the name below.
#
# The three values below are working local-only placeholders so a fresh copy of
# this file comes up without editing. Change them if you intend to keep the
# instance around.
GITLAB_ADMIN_USERNAME=tutorial-admin
GITLAB_ADMIN_PASSWORD=placeholder-Pw-9fa2
GITLAB_ADMIN_EMAIL=admin@example.com

GITLAB_OWNER_USERNAME=owner
GITLAB_OWNER_PASSWORD=placeholder-Pw-9fo2
GITLAB_OWNER_EMAIL=owner@example.com

GITLAB_DEVELOPER_USERNAME=developer
GITLAB_DEVELOPER_PASSWORD=placeholder-Pw-9fd2
GITLAB_DEVELOPER_EMAIL=developer@example.com


# ---------------------------------------------------------------- runner
# The runner registers itself from the token written to
# temp/gitlab_credentials/runner.env; there is no interactive register step.
RUNNER_DESCRIPTION=gitlab-tutorial-runner
RUNNER_CONCURRENT=2

# Default image for jobs that do not declare one of their own. Reaching the host
# daemon over the mounted socket needs only the Docker CLI, so that is the floor
# every job image has to meet.
RUNNER_JOB_IMAGE=docker:24.0.5-cli
